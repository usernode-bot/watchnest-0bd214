{
  "name": "WatchNest",
  "icon": "🪺",
  "secrets": [],
  "tests": [
    {
      "name": "Watch Next home renders",
      "path": "/?demo=1&screen=home",
      "expectSelector": "[data-screen=home]",
      "expectText": "Watch next"
    },
    {
      "name": "Discover renders all media types",
      "path": "/?demo=1&screen=discover",
      "expectSelector": "[data-screen=discover]",
      "expectText": "Movies, shows & anime"
    },
    {
      "name": "Library and title progress render",
      "path": "/?demo=1&screen=library&detail=tvmaze%3A101",
      "expectSelector": "[data-screen=detail]",
      "expectText": "Episodes"
    },
    {
      "name": "Upcoming calendar renders",
      "path": "/?demo=1&screen=upcoming",
      "expectSelector": "[data-screen=upcoming]",
      "expectText": "Your upcoming"
    },
    {
      "name": "Private stats and data controls render",
      "path": "/?demo=1&screen=profile",
      "expectSelector": "[data-screen=profile]",
      "expectText": "Your watch time"
    },
    {
      "name": "Newer-device warning stays visible",
      "path": "/?demo=1&screen=library&stale=1",
      "expectSelector": "[data-remote-ahead-warning]",
      "expectText": "Another device has newer data"
    },
    {
      "name": "Device-only data notice is explicit",
      "path": "/?demo=1&screen=home&local-only=1",
      "expectSelector": "[data-device-only-notice]",
      "expectText": "Viewing data does not sync between devices"
    },
    {
      "name": "Guest mode keeps every local feature",
      "path": "/?guest=1&screen=profile",
      "expectSelector": "[data-screen=profile]",
      "expectText": "Only newer-device detection requires an account"
    }
  ]
}
